ride exists."}],["$","h4",null,{"children":"Conversion Events"}],["$","p",null,{"children":"The conversion events page defines global conversion windows for reusable events. Those defaults apply to all experiments unless overridden within an experiment."}],["$","h4",null,{"children":"Dimensions"}],["$","p",null,{"children":"Dimensions expose the shared slicing schema used by the warehouse. They describe what attributes are available for balance checks and future segmentation."}],["$","h4",null,{"children":"Power Calculator"}],"$L6","$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f"]}]]}],null,"$L20"]}],{},null,false]},null,false]},null,false],"$L21",false]],"m":"$undefined","G":["$22",[]],"s":false,"S":true}
