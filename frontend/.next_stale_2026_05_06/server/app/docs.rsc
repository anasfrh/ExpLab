11:["$","div",null,{"className":"schema-diagram","aria-label":"Warehouse schema relationships","children":[["$","div",null,{"className":"schema-card schema-card-primary","children":[["$","div",null,{"className":"schema-title","children":["$","code",null,{"children":"experiments"}]}],["$","ul",null,{"children":[["$","li",null,{"children":["$","code",null,{"children":"user_id"}]}],["$","li",null,{"children":["$","code",null,{"children":"experiment_id"}]}],["$","li",null,{"children":["$","code",null,{"children":"variation_id"}]}],["$","li",null,{"children":["$","code",null,{"children":"timestamp"}]}]]}]]}],["$","div",null,{"className":"schema-links","aria-hidden":"true","children":[["$","span",null,{"children":"joins on `user_id`"}],["$","span",null,{"children":"joins on `user_id`"}],["$","span",null,{"children":"joins on `user_id`"}]]}],["$","div",null,{"className":"schema-column","children":[["$","div",null,{"className":"schema-card","children":[["$","div",null,{"className":"schema-title","children":["$","code",null,{"children":"metrics"}]}],["$","ul",null,{"children":[["$","li",null,{"children":["$","code",null,{"children":"user_id"}]}],["$","li",null,{"children":["$","code",null,{"children":"metric_name"}]}],["$","li",null,{"children":["$","code",null,{"children":"value"}]}],["$","li",null,{"children":["$","code",null,{"children":"date"}]}]]}]]}],["$","div",null,{"className":"schema-card","children":[["$","div",null,{"className":"schema-title","children":["$","code",null,{"children":"conversion_events"}]}],["$","ul",null,{"children":[["$","li",null,{"children":["$","code",null,{"children":"user_id"}]}],["$","li",null,{"children":["$","code",null,{"children":"event_name"}]}],["$","li",null,{"children":["$","code",null,{"children":"timestamp"}]}]]}]]}],["$","div",null,{"className":"schema-card","children":[["$","div",null,{"className":"schema-title","children":["$","code",null,{"children":"dimensions"}]}],["$","ul",null,{"children":[["$","li",null,{"children":["$","code",null,{"children":"user_id"}]}],["$","li",null,{"children":["$","code",null,{"children":"country_code"}]}],["$","li",null,{"children":["$","code",null,{"children":"mcc"}]}],["$","li",null,{"children":["$","code",null,{"children":"os"}]}]]}]]}]]}]]}]
12:["$","h4",null,{"children":"Recommended SQL DDL"}]
13:["$","pre",null,{"className":"docs-code-block","children":["$","code",null,{"children":"CREATE TABLE experiments (\n  user_id TEXT NOT NULL,\n  experiment_id TEXT NOT NULL,\n  variation_id TEXT NOT NULL,\n  timestamp TIMESTAMP NOT NULL\n);\n\nCREATE TABLE metrics (\n  user_id TEXT NOT NULL,\n  metric_name TEXT NOT NULL,\n  value NUMERIC NOT NULL,\n  date DATE NOT NULL\n);\n\nCREATE TABLE conversion_events (\n  user_id TEXT NOT NULL,\n  event_name TEXT NOT NULL,\n  timestamp TIMESTAMP NOT NULL\n);\n\nCREATE TABLE dimensions (\n  user_id TEXT PRIMARY KEY,\n  country_code TEXT,\n  mcc TEXT,\n  os TEXT\n);"}]}]
14:["$","h4",null,{"children":"How ExpLab Uses Each Table"}]
15:["$","div",null,{"className":"docs-steps","children":[["$","div",null,{"className":"docs-step","children":[["$","span",null,{"children":"1"}],["$","p",null,{"children":["ExpLab starts from ",["$","code",null,{"children":"experiments"}]," to identify the users in a given experiment and the variant each user saw."]}]]}],["$","div",null,{"className":"docs-step","children":[["$","span",null,{"children":"2"}],["$","p",null,{"children":["It joins ",["$","code",null,{"children":"dimensions"}]," on ",["$","code",null,{"children":"user_id"}]," so it can run balance checks and segmentation."]}]]}],["$","div",null,{"className":"docs-step","children":[["$","span",null,{"children":"3"}],["$","p",null,{"children":["It reads ",["$","code",null,{"children":"metrics"}]," for continuous outcomes and keeps only post-exposure dates within the selected analysis window."]}]]}],["$","div",null,{"className":"docs-step","children":[["$","span",null,{"children":"4"}],["$","p",null,{"children":["It reads ",["$","code",null,{"children":"conversion_events"}]," for binary outcomes and marks whether each user converted inside the configured window."]}]]}]]}]
16:["$","h4",null,{"children":"Setup Principles"}]
17:["$","ul",null,{"className":"docs-list","children":[["$","li","Use the same `user_id` in every warehouse-facing table.",{"children":"Use the same `user_id` in every warehouse-facing table."}],["$","li","Store experiment exposure time in `experiments.timestamp` and keep it immutable.",{"children":"Store experiment exposure time in `experiments.timestamp` and keep it immutable."}],["$","li","Store metrics in tall format instead of one wide row with many metric columns.",{"children":"Store metrics in tall format instead of one wide row with many metric columns."}],["$","li","Keep conversion events event-level. Do not pre-aggregate them into counts if you want flexible windows.",{"children":"Keep conversion events event-level. Do not pre-aggregate them into counts if you want flexible windows."}],["$","li","Keep at least one row in `dimensions` for every exposed user so balance checks can run.",{"children":"Keep at least one row in `dimensions` for every exposed user so balance checks can run."}]]}]
18:["$","h4",null,{"children":"ExpLab Metadata Tables"}]
19:["$","p",null,{"children":"Besides your warehouse-facing tables, ExpLab stores application metadata that controls how analyses are configured. These tables are internal to ExpLab and do not need to come from your product warehouse."}]
