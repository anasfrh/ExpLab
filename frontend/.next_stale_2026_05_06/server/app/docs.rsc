1e:["$","ul",null,{"className":"docs-list","children":[["$","li","Multiple rows for the same user in `dimensions`, which breaks the one-user join shape.",{"children":"Multiple rows for the same user in `dimensions`, which breaks the one-user join shape."}],["$","li","Using different user identifiers across assignment, metric, and event tables.",{"children":"Using different user identifiers across assignment, metric, and event tables."}],["$","li","Writing daily aggregates by variant instead of user-level rows.",{"children":"Writing daily aggregates by variant instead of user-level rows."}],["$","li","Backfilling metrics that occurred before exposure into the post-exposure window.",{"children":"Backfilling metrics that occurred before exposure into the post-exposure window."}],["$","li","Changing variant labels mid-experiment instead of keeping a stable `variation_id`.",{"children":"Changing variant labels mid-experiment instead of keeping a stable `variation_id`."}]]}]
